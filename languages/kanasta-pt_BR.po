msgstr ""
"Olá {customer_name}! Seu pedido *#{order_number}* está a caminho de "
"{shipping_address}."

#: includes/pro/class-kanasta-pro-notify.php:63
msgid ""
"Hi {customer_name}! Your order *#{order_number}* is ready for pickup at "
"{site_name}."
msgstr ""
"Olá {customer_name}! Seu pedido *#{order_number}* está pronto para retirada "
"em {site_name}."

