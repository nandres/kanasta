msgstr "Ahora estamos cerrados."

#: includes/pro/class-kanasta-pro-notify.php:31
msgid "Order confirmed"
msgstr "Pedido confirmado"

#: includes/pro/class-kanasta-pro-notify.php:32
msgid "Payment reminder"
msgstr "Recordatorio de pago"

#: includes/pro/class-kanasta-pro-notify.php:33
