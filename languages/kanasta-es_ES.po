msgstr "Mensajes a clientes (Pro)"

#: includes/pro/class-kanasta-pro-notify.php:47
msgid ""
"These messages appear as buttons in the \"WhatsApp\" box of each order. They"
" use the same tags as the order message."
msgstr ""
"Estos mensajes aparecen como botones en la caja \"WhatsApp\" de cada pedido."
" Usan las mismas etiquetas que el mensaje del pedido."

#: includes/pro/class-kanasta-pro-notify.php:60
msgid ""
"Hi {customer_name}! Your order *#{order_number}* is confirmed. Total: "
"{total}. Thank you for buying at {site_name}!"
msgstr ""
"¡Hola {customer_name}! Tu pedido *#{order_number}* está confirmado. Total: "
"{total}. ¡Gracias por comprar en {site_name}!"

#: includes/pro/class-kanasta-pro-notify.php:61
msgid ""
"Hi {customer_name}! We are waiting for the payment of your order "
"*#{order_number}* ({total}). Let us know if you need the payment details."
msgstr ""
"¡Hola {customer_name}! Estamos esperando el pago de tu pedido "
"*#{order_number}* ({total}). Avísanos si necesitas los datos para pagar."

#: includes/pro/class-kanasta-pro-notify.php:62
msgid ""
"Hi {customer_name}! Your order *#{order_number}* is on its way to "
"{shipping_address}."
msgstr ""
"¡Hola {customer_name}! Tu pedido *#{order_number}* va en camino a "
"{shipping_address}."

#: includes/pro/class-kanasta-pro-notify.php:63
msgid ""
"Hi {customer_name}! Your order *#{order_number}* is ready for pickup at "
"{site_name}."
msgstr ""
"¡Hola {customer_name}! Tu pedido *#{order_number}* está listo para retirar "
"en {site_name}."

